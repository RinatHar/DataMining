    {
      "parameters": {
        "jsCode": "const authorUrl = $json.author_url || '';\n\n// Ищем одну цитату-«представителя» этого автора из Set quote typed, чтобы восстановить контекст\nconst all = $('Set quote typed').all();\nconst match = all.find(i => i.json.author_url === authorUrl) || all[0];\n\nif (!match) {\n  return [];\n}\n\nconst q = match.json;\n\nreturn [{\n  json: {\n    author_url: authorUrl,\n    author: q.author,\n    business_key: q.business_key,\n    quote: q.quote,\n    tags: q.tags,\n    source_tag: q.source_tag,\n    source: q.source,\n    author_born_date: $json.bornDate ?? '',\n    author_born_place: $json.bornPlace ?? '',\n    author_bio: $json.authorBio ?? ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9696,
        11776
      ],
      "name": "Restore quote context",
      "id": "1bf22b47-bdc5-4d54-a38d-752b8ba31313",
