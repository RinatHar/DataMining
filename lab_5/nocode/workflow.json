          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ (() => {\n  const body = String($response.body ?? '');\n  const match = body.match(/<li\\s+class=[\"']next[\"'][^>]*>\\s*<a\\s+href=[\"']([^\"']+)[\"']/i);\n  if (match && match[1]) {\n    return 'https://quotes.toscrape.com' + match[1];\n  }\n  return 'https://quotes.toscrape.com';\n})() }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !/<li\\s+class=[\"']next[\"'][^>]*>\\s*<a\\s+href=[\"'][^\"']+[\"']/i.test(String($response.body ?? '')) }}",
              "limitPagesFetched": true,
              "requestInterval": 50
            }
          }
        }
      },
