    {
      "parameters": {
        "jsCode": "const text = items[0].json.data || '';\nconst out = [];\nfor (const line of text.split(/\\r?\\n/)) {\n  const t = line.trim();\n  if (!t) continue;\n  try {\n    const r = JSON.parse(t);\n    r._kind = 'weather';\n    out.push({ json: r });\n  } catch (e) {}\n}\nreturn out;"
      },
      "id": "1999b715-3aa2-4f5e-b635-206e6fe3b002",
      "name": "Parse Weather JSONL",
