        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = items[0].json.data || '';\nconst out = [];\nfor (const line of text.split(/\\r?\\n/)) {\n  const t = line.trim();\n  if (!t) continue;\n  try {\n    const r = JSON.parse(t);\n    r._kind = 'book';\n    out.push({ json: r });\n  } catch (e) {}\n}\nreturn out;"
      },
      "id": "fbedecba-f5d4-4c70-90d0-c15d7e63459a",
      "name": "Parse Books JSONL",
      "type": "n8n-nodes-base.code",
