    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO unified_facts (business_key, source, title, metric_numeric, collected_at, updated_at)\nVALUES (\n  $$ {{ $json.business_key }} $$, \n  $$ {{ $json.source }} $$, \n  $$ {{ $json.title }} $$, \n  {{ $json.metric_numeric }}, \n  $$ {{ $json.collected_at }} $$::timestamptz, \n  NOW()\n)\nON CONFLICT (business_key) DO UPDATE SET\n  metric_numeric = EXCLUDED.metric_numeric,\n  updated_at = NOW()\nWHERE unified_facts.metric_numeric IS DISTINCT FROM EXCLUDED.metric_numeric;",
        "options": {}
      },
