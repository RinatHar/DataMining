      "position": [
        480,
        304
      ]
    },
    {
      "parameters": {},
      "id": "787d5058-391f-4bac-a0c6-eb90e2cb54fd",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        720,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of items){\n  const r = item.json;\n  const isWeather = r._kind === 'weather';\n  \n  // 1. Формируем бизнес-ключ\n  let business_key = '';\n  if (isWeather) {\n      business_key = `weather_${r.date_raw}`;\n  } else {\n      // Безопасная очистка названия от спецсимволов\n      business_key = String(r.title_raw || '').toLowerCase().replace(/[^a-z0-9]/g, '_');\n  }\n\n  // 2. Извлекаем метрику (цену или температуру)\n  let metric = null;\n  if (isWeather) {\n      // Для погоды температура лежит в price_raw (согласно Ячейке 2 Python)\n      metric = parseFloat(r.price_raw);\n  } else {\n      // Для книг очищаем строку от Â£, оставляя только цифры и точку\n      const cleanPrice = String(r.price_raw || '').replace(/[^\\d.]/g, '');\n      metric = parseFloat(cleanPrice);\n  }\n  \n  // 3. Валидация\n  const errs = [];\n  if (!business_key || business_key.length < 3) {\n      errs.push('missing or short key');\n  }\n  if (isNaN(metric) || metric === null) {\n      errs.push('invalid metric');\n  }\n  \n  // 4. Формируем результат\n  out.push({ json: {\n    business_key: business_key,\n    source: r._source,\n    title: r.title_raw,\n    metric_numeric: metric,\n    collected_at: r._collected_at,\n    _valid: errs.length === 0,\n    _reason: errs.join('; ')\n  }});\n}\nreturn out;"
      },
      "id": "6d522dd4-d29b-4b39-85e4-1018b77f0470",
      "name": "Normalize",
